# Browser-safe Supabase project values. The app accepts either key variable;
# VITE_SUPABASE_PUBLISHABLE_KEY takes precedence when both are present.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_public_key"
# Backward-compatible name used by the previous repository's Cloudflare setup.
# VITE_SUPABASE_ANON_KEY="your-public-anon-or-publishable-key"
# Cloudflare Pages Functions use these names to validate signed-in sessions.
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_public_key"
# Existing Supabase projects can use the public anon key under this name.
# SUPABASE_ANON_KEY="your-public-anon-key"
# Required for server-side account deletion. Keep this secret server-only; never use a VITE_ prefix.
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Local server-side secret. Never prefix it with VITE_ or expose it to the browser.
# Optional: enables the economic calendar endpoint.
FINANCE_CALENDAR_API_KEY="your-finance-calendar-api-key"
