{
  "id": "/journal",
  "name": "Xecutd Journal",
  "short_name": "Xecutd",
  "description": "A focused trading journal for tracking trades, process, and performance.",
  "start_url": "/journal",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f4f4f5",
  "theme_color": "#f4f4f5",
  "icons": [
    { "src": "/icons/xecutd-logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/xecutd-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/xecutd-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/xecutd-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
